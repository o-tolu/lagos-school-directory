# Copy this file to .env and fill in your values. Never commit .env.

# Your local PostgreSQL connection URL (create an empty database first, e.g. lagos_schools_crm)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lagos_schools_crm
# Set to true only for hosted databases that require SSL
DATABASE_SSL=false

# API server
PORT=3001
# 127.0.0.1 = only this PC. Use 0.0.0.0 to let other devices on your network connect.
HOST=127.0.0.1

# Create/upgrade tables automatically when the server starts
AUTO_MIGRATE=true

# Open access today. Reserved switch for future login / role-based access (see server/middleware/auth.js)
AUTH_ENABLED=false
